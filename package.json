{
  "name": "y99-price-hunter",
  "productName": "Y99 Price Hunter",
  "version": "1.0.1",
  "description": "Watch prices for the gear you want across online stores, Facebook Marketplace and OLX \u2014 using your own logged-in accounts.",
  "main": "main.js",
  "author": "Y99 <y99.agency@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/match.test.js test/hunter.test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.y99.pricehunter",
    "productName": "Y99 Price Hunter",
    "copyright": "Copyright \u00a9 2026 Y99",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Y99-Price-Hunter-Windows-NoInstall.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Y99 Price Hunter",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Y99-Price-Hunter-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Y99-Price-Hunter-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Y99-Price-Hunter-Mac.${ext}"
    },
    "afterPack": "build/after-pack.js",
    "dmg": {
      "title": "Y99 Price Hunter",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 450,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 300,
          "y": 330,
          "type": "file",
          "path": "build/Open-Me-First-Mac.command"
        }
      ],
      "window": {
        "width": 600,
        "height": 440
      }
    }
  }
}