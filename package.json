{
  "name": "y99-price-hunter",
  "productName": "Y99 Price Hunter",
  "version": "1.0.0",
  "description": "Watch prices for the gear you want across online stores, Facebook Marketplace and OLX — using your own logged-in accounts.",
  "main": "main.js",
  "author": "Y99 <y99.agency@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.y99.pricehunter",
    "productName": "Y99 Price Hunter",
    "copyright": "Copyright © 2026 Y99",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "ui/**/*", "build/icon.png", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Y99 Price Hunter",
      "artifactName": "Y99-Price-Hunter-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Y99-Price-Hunter-Portable-${version}.${ext}" },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Y99-Price-Hunter-${version}-mac-${arch}.${ext}"
    }
  }
}
